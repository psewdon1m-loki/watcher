limit_req_zone $binary_remote_addr zone=watcher_api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=watcher_assets:10m rate=3r/s;
limit_req_zone $binary_remote_addr zone=watcher_subscriptions:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=watcher_initialization:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=watcher_connections:10m;

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    if ($host != ${NGINX_SERVER_NAME}) { return 444; }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};
    if ($host != ${NGINX_SERVER_NAME}) { return 444; }
    server_tokens off;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream api:8080;
    set $web_upstream web:8080;

    ssl_certificate ${NGINX_CERTIFICATE};
    ssl_certificate_key ${NGINX_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 60s;
    limit_conn watcher_connections 40;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;

    location = /health {
        proxy_pass http://$api_upstream;
    }

    location = /manifest.json {
        proxy_pass http://$api_upstream;
    }

    location /assets/ {
        limit_req zone=watcher_assets burst=10 nodelay;
        proxy_pass http://$api_upstream;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /api/ {
        limit_req zone=watcher_api burst=60 nodelay;
        proxy_pass http://$api_upstream;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /api/v1/public/connections/initialize {
        limit_req zone=watcher_initialization burst=3 nodelay;
        proxy_pass http://$api_upstream;
        proxy_read_timeout 90s;
        proxy_send_timeout 30s;
    }

    location /sub/ {
        access_log off;
        limit_req zone=watcher_subscriptions burst=20 nodelay;
        proxy_pass http://$api_upstream;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location = / {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        proxy_pass http://$web_upstream;
    }

    location = /app.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        proxy_pass http://$web_upstream;
    }

    location = /styles.css {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        proxy_pass http://$web_upstream;
    }

    location / {
        proxy_pass http://$web_upstream;
    }
}
