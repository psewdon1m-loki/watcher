LOKI_WATCHER_DASHBOARD_USERNAME=admin
LOKI_WATCHER_DASHBOARD_PASSWORD=change-me
LOKI_WATCHER_LOG_RETENTION_DAYS=7
LOKI_WATCHER_COMMAND_RETENTION_DAYS=30
LOKI_WATCHER_BACKUP_INTERVAL_SECONDS=86400
LOKI_WATCHER_BACKUP_RETENTION_DAYS=30

LOKI_WATCHER_GITHUB_REPOSITORY=psewdon1m-loki/pc-client
LOKI_WATCHER_GITHUB_RELEASE=latest
LOKI_WATCHER_GITHUB_TOKEN=
LOKI_WATCHER_UPDATE_CHANNEL=stable
LOKI_WATCHER_UPDATE_CACHE_SECONDS=300
LOKI_WATCHER_RULE_SET_IDS=russia-smart,global,whitelist,blacklist

LOKI_WATCHER_PUBLIC_URL=https://loki-p-watcher.shmoza.net
LOKI_WATCHER_PUBLIC_SNI=loki-p-watcher.shmoza.net

LOKI_NGINX_HTTP_PORT=80
LOKI_NGINX_HTTPS_PORT=443
LOKI_NGINX_CERTS_HOST_DIR=./nginx/certs
LOKI_NGINX_CERTIFICATE=/etc/nginx/certs/fullchain.pem
LOKI_NGINX_CERTIFICATE_KEY=/etc/nginx/certs/privkey.pem
LOKI_NGINX_CLIENT_MAX_BODY_SIZE=300m

# Bound only to localhost for diagnostics. Public traffic should use nginx 80/443.
LOKI_WATCHER_API_PORT=18080
LOKI_WATCHER_WEB_PORT=18081
